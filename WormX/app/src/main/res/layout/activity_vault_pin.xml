<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:gravity="center"
    android:padding="30dp">

    <TextView
        android:id="@+id/pinTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/unlock_vault"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/pinSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:textAlignment="center"
        android:layout_marginBottom="20dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="30dp">

        <View android:id="@+id/dot1" android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="7dp" android:background="@drawable/bg_dot" />
        <View android:id="@+id/dot2" android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="7dp" android:background="@drawable/bg_dot" />
        <View android:id="@+id/dot3" android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="7dp" android:background="@drawable/bg_dot" />
        <View android:id="@+id/dot4" android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="7dp" android:background="@drawable/bg_dot" />
    </LinearLayout>

    <GridLayout
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:columnCount="3">

        <TextView android:id="@+id/key1" style="@style/PinKey" android:text="1" />
        <TextView android:id="@+id/key2" style="@style/PinKey" android:text="2" />
        <TextView android:id="@+id/key3" style="@style/PinKey" android:text="3" />
        <TextView android:id="@+id/key4" style="@style/PinKey" android:text="4" />
        <TextView android:id="@+id/key5" style="@style/PinKey" android:text="5" />
        <TextView android:id="@+id/key6" style="@style/PinKey" android:text="6" />
        <TextView android:id="@+id/key7" style="@style/PinKey" android:text="7" />
        <TextView android:id="@+id/key8" style="@style/PinKey" android:text="8" />
        <TextView android:id="@+id/key9" style="@style/PinKey" android:text="9" />
        <View android:layout_width="80dp" android:layout_height="80dp" />
        <TextView android:id="@+id/key0" style="@style/PinKey" android:text="0" />
        <TextView android:id="@+id/keyDelete" style="@style/PinKey" android:text="⌫" />
    </GridLayout>

    <TextView
        android:id="@+id/lockoutMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/danger"
        android:textSize="12sp"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/biometricButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Use biometric unlock"
        android:textColor="@color/accent_vault"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/resetPinButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forgot PIN? Reset it"
        android:textColor="@color/accent_vault"
        android:textSize="12sp"
        android:layout_marginTop="14dp"
        android:visibility="gone" />

</LinearLayout>
