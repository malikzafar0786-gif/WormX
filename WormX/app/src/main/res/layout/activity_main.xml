<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <TextView
        android:id="@+id/appTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:textSize="17sp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== Orb hero: glow ring + center icon/percentage ===== -->
    <FrameLayout
        android:id="@+id/orbWrap"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/appTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.wormx.app.ui.OrbProgressView
            android:id="@+id/orbProgress"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/orbIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_download_arrow"
                app:tint="@color/accent_download" />

            <TextView
                android:id="@+id/orbPctText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/accent_download"
                android:textSize="15sp"
                android:layout_marginTop="4dp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/heroLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="30dp"
        android:text="Copy a link from any app — WormX grabs it instantly"
        android:textColor="@color/text_dim"
        android:textSize="13sp"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/orbWrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/pastePill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/paste_and_download"
        android:textColor="@color/text_primary"
        android:background="@drawable/bg_pill"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/heroLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/sectionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/active_downloads"
        android:textColor="@color/text_faint"
        android:textAllCaps="true"
        android:textSize="12sp"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/pastePill" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/downloadsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/sectionLabel"
        app:layout_constraintBottom_toTopOf="@id/bottomBar" />

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No active downloads.\nTap the orb or paste a link to start one."
        android:textColor="@color/text_faint"
        android:textAlignment="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/downloadsList"
        app:layout_constraintBottom_toBottomOf="@id/downloadsList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/surface"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/homeNavButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Home"
            android:textColor="@color/text_primary"
            android:gravity="center" />

        <TextView
            android:id="@+id/grabFab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Grab"
            android:textColor="@color/bg"
            android:background="@drawable/bg_pill_accent"
            android:gravity="center"
            android:paddingVertical="10dp" />

        <TextView
            android:id="@+id/vaultNavButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vault"
            android:textColor="@color/text_faint"
            android:gravity="center" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
